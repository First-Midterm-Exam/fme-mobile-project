# Configuración de Asistente Readiness.
# No guardar aquí claves ni secretos: este archivo se empaqueta dentro del APK.

# URL base de la API de Laravel (incluye el prefijo /api).
#   Emulador de Android contra Laravel local: http://10.0.2.2:8000/api
#   Teléfono físico en la misma red:          http://<IP-de-tu-PC>:8000/api
API_BASE_URL=http://10.0.2.2:8000/api

# true  -> usa datos simulados (no se conecta al servidor).
# false -> consume los endpoints reales en API_BASE_URL.
USE_MOCK=true
